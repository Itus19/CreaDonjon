# Variables d'environnement — voir PDD §28 pour le tableau complet.
# Copier ce fichier en .env.local (jamais commite) et renseigner les valeurs reelles.

# --- Cote client (prefixe NEXT_PUBLIC_, embarquees dans le bundle navigateur) ---

# URL du projet Supabase. Visible publiquement, sans risque.
NEXT_PUBLIC_SUPABASE_URL=

# Cle publique (anon/publishable) Supabase. Protegee uniquement par les
# policies RLS, jamais par le secret : elle est visible dans le navigateur.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Cote serveur uniquement (jamais de prefixe NEXT_PUBLIC_, jamais importees
# dans un fichier "use client") ---

# Cle service_role Supabase : contourne RLS. Reservee aux traitements serveur
# qui en ont explicitement besoin (ex. scripts d'import SRD).
SUPABASE_SERVICE_ROLE_KEY=

# Cle API Anthropic (Claude), pour les fonctionnalites IA (narration solo,
# ai_proposals, resumes).
ANTHROPIC_API_KEY=

# Cle API Voyage AI, pour les embeddings de recherche semantique (chunks,
# PDD §30). Anthropic ne propose pas d'endpoint d'embeddings.
VOYAGE_API_KEY=
